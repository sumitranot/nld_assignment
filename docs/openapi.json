{
  "openapi": "3.0.3",
  "info": {
    "title": "NLD Assessment - Logistics Order Management API",
    "version": "1.0.0",
    "description": "Production-grade RESTful API for logistics warehouse management with concurrency-safe stock deduction and RBAC."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "BAD_REQUEST" },
              "message": { "type": "string", "example": "Validation failed" },
              "details": { "type": "object" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "SafeUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "email": { "type": "string", "example": "user@example.com" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"], "example": "USER" },
          "access": { "type": "string", "enum": ["VIEW", "CREATE"], "nullable": true, "example": "CREATE" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "role"]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/SafeUser" },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
        },
        "required": ["user", "token"]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Cardboard Box Small" },
          "sku": { "type": "string", "example": "SKU-BOX-SM-001" },
          "stockQty": { "type": "integer", "minimum": 0, "example": 150 },
          "price": { "type": "string", "example": "1.85" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "sku", "stockQty", "price"]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "orderId": { "type": "integer", "example": 1 },
          "productId": { "type": "integer", "example": 5 },
          "quantity": { "type": "integer", "example": 2 },
          "unitPrice": { "type": "string", "example": "12.40" },
          "product": { "$ref": "#/components/schemas/Product" }
        },
        "required": ["id", "orderId", "productId", "quantity", "unitPrice"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "userId": { "type": "integer", "example": 3 },
          "orderNumber": { "type": "string", "example": "ORD-20261103-A8F2B1" },
          "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED"], "example": "PENDING" },
          "totalAmount": { "type": "string", "example": "24.80" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" } }
        },
        "required": ["id", "userId", "orderNumber", "status", "totalAmount"]
      },
      "OrderListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "orderNumber": { "type": "string", "example": "ORD-20261103-A8F2B1" },
          "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED"], "example": "PENDING" },
          "totalAmount": { "type": "string", "example": "24.80" },
          "createdAt": { "type": "string", "format": "date-time" },
          "itemCount": { "type": "integer", "example": 5 },
          "lineCount": { "type": "integer", "example": 2 },
          "userId": { "type": "integer", "example": 3 }
        },
        "required": ["id", "orderNumber", "status", "totalAmount", "createdAt", "itemCount", "lineCount", "userId"]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "example": 45 },
          "totalPages": { "type": "integer", "example": 5 }
        },
        "required": ["page", "limit", "total", "totalPages"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "password": { "type": "string", "minLength": 6, "example": "User@123" },
                  "role": { "type": "string", "enum": ["ADMIN", "USER"], "example": "USER" },
                  "access": { "type": "string", "enum": ["VIEW", "CREATE"], "default": "VIEW" }
                },
                "required": ["email", "password", "role"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "Email already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and issue JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "create@example.com" },
                  "password": { "type": "string", "example": "User@123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "user": { "$ref": "#/components/schemas/SafeUser" } }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List products with debounced search and pagination",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Case-insensitive ILIKE search on name and SKU" }
        ],
        "responses": {
          "200": {
            "description": "Paginated products list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create product (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Heavy Duty Pallet" },
                  "sku": { "type": "string", "example": "SKU-PAL-099" },
                  "stockQty": { "type": "integer", "minimum": 0, "example": 50 },
                  "price": { "type": "string", "example": "45.00" }
                },
                "required": ["name", "sku", "stockQty", "price"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "403": { "description": "Forbidden - requires ADMIN role" },
          "409": { "description": "SKU already exists" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Product details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "404": { "description": "Product not found" }
        }
      },
      "put": {
        "summary": "Update product (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "sku": { "type": "string" },
                  "stockQty": { "type": "integer", "minimum": 0 },
                  "price": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Product updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "403": { "description": "Forbidden - requires ADMIN role" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "List orders with filters, pagination, and SQL item count aggregations",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED"] } },
          { "name": "from", "in": "query", "schema": { "type": "string" }, "description": "Start date (YYYY-MM-DD or ISO)" },
          { "name": "to", "in": "query", "schema": { "type": "string" }, "description": "End date (YYYY-MM-DD or ISO)" },
          { "name": "userId", "in": "query", "schema": { "type": "integer" }, "description": "Filter by user ID (Admin only)" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated order list with item counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/OrderListItem" } },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create order with pessimistic row locking and atomic stock reduction",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": { "type": "string", "example": "SKU-BOX-SM-001" },
                        "qty": { "type": "integer", "minimum": 1, "example": 2 }
                      },
                      "required": ["sku", "qty"]
                    }
                  }
                },
                "required": ["items"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "Validation error" },
          "403": { "description": "Forbidden - user lacks CREATE access" },
          "404": { "description": "One or more SKUs not found" },
          "409": { "description": "Insufficient stock" }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Get order details",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Order details with line items", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "summary": "Cancel eligible order (PENDING/CONFIRMED) and restore stock in transaction",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Order cancelled and stock restored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "403": { "description": "Forbidden - requires CREATE access" },
          "404": { "description": "Order not found" },
          "409": { "description": "Order already cancelled or ineligible" }
        }
      }
    },
    "/orders/{id}/confirm": {
      "patch": {
        "summary": "Confirm a PENDING order (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Order confirmed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "403": { "description": "Forbidden - requires ADMIN role" },
          "404": { "description": "Order not found" },
          "409": { "description": "Order is not in PENDING status" }
        }
      }
    }
  }
}

